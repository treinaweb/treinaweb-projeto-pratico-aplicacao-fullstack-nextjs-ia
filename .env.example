# Local PostgreSQL (see docker-compose.yml). Start it with `docker compose up -d`.
DATABASE_URL="postgresql://twjobs:twjobs@localhost:5432/twjobs_ai"

# Better-Auth
BETTER_AUTH_URL="http://localhost:3000"
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# OpenAI (used by the AI features through lib/ai/provider.ts)
OPENAI_API_KEY=""
# Optional: override the model used by the job posting parser (default: gpt-5.4-mini)
# OPENAI_JOB_PARSER_MODEL="gpt-5.4-mini"
# Optional: override the model used by the resume writer (default: gpt-5.4-mini)
# OPENAI_RESUME_WRITER_MODEL="gpt-5.4-mini"
# Optional: override the model used by the interview simulator (default: gpt-5.4-mini)
# OPENAI_INTERVIEWER_MODEL="gpt-5.4-mini"
# Optional: override the model used by the interview analysis (default: gpt-5.4-mini)
# OPENAI_INTERVIEW_ANALYZER_MODEL="gpt-5.4-mini"
